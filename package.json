{
  "name": "pme-erp-backend",
  "version": "1.0.0",
  "description": "Arquitetura base e modelagem de backend para ERP de PMEs (Vendas, Compras/Estoque, Financeiro)",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "npm run build && jest --runInBand && node --test test/*.test.cjs",
    "start": "node --env-file=.env dist/main.js",
    "start:dev": "npm run build && node --env-file=.env dist/main.js",
    "dev": "npm run start:dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "admin:bootstrap": "node --env-file=.env scripts/bootstrap-admin.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.0"
  }
}
