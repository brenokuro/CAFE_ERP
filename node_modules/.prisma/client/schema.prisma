// prisma/schema.prisma
// Modelagem de Dados - ERP Simplificado para Pequenas e Médias Empresas (PMEs)
// Foco: Vendas/Faturamento, Compras/Estoque e Gestão Financeira com Multi-Tenancy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS DO DOMÍNIO
// ==========================================

enum TaxRegime {
  MEI
  SIMPLES_NACIONAL
  SIMPLES_NACIONAL_EXCESSO
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  PURCHASING
  FINANCIAL
  STOCK
  OPERATOR
}

enum PersonType {
  INDIVIDUAL // Pessoa Física (CPF)
  LEGAL_ENTITY // Pessoa Jurídica (CNPJ)
}

enum ContactRole {
  CUSTOMER // Cliente
  SUPPLIER // Fornecedor
  BOTH // Ambos (Cliente e Fornecedor)
}

enum ProductType {
  PRODUCT // Mercadoria / Produto Físico
  SERVICE // Serviço prestado
}

enum SalesOrderStatus {
  DRAFT // Rascunho / Orçamento
  APPROVED // Pedido Aprovado
  INVOICED // Faturado (NF emitida / Estoque e Financeiro baixados)
  CANCELLED // Cancelado
}

enum PurchaseOrderStatus {
  DRAFT // Cotação / Rascunho
  APPROVED // Pedido de Compra Aprovado
  RECEIVED // Recebido / Entregue (Estoque acrescido, Contas a Pagar gerado)
  CANCELLED // Cancelado
}

enum UnitOfMeasure {
  UN
  KG
  G
  L
  ML
  M
}

enum MovementDirection {
  IN
  OUT
  TRANSFER
}

enum StockMovementType {
  IN_PURCHASE // Entrada por Compra
  IN_RETURN // Entrada por Devolução de Venda
  IN_ADJUSTMENT // Ajuste de Inventário (Entrada)
  OUT_SALE // Saída por Venda
  OUT_RETURN // Saída por Devolução a Fornecedor
  OUT_LOSS // Perda / Avaria / Descarte
  OUT_ADJUSTMENT // Ajuste de Inventário (Saída)
}

enum StockReferenceType {
  SALES_ORDER
  PURCHASE_ORDER
  INVENTORY_ADJUSTMENT
  MANUAL
}

enum AccountCategoryType {
  REVENUE // Receita
  EXPENSE // Despesa
  ASSET // Ativo
  LIABILITY // Passivo
}

enum FinancialRecordType {
  RECEIVABLE // Conta a Receber
  PAYABLE // Conta a Pagar
}

enum FinancialRecordStatus {
  PENDING // Aberto / A vencer
  PARTIALLY_PAID // Parcialmente Pago
  PAID // Liquidado / Pago
  OVERDUE // Vencido
  CANCELLED // Cancelado
}

enum BankAccountType {
  CHECKING // Conta Corrente
  SAVINGS // Poupança
  INVESTMENT // Aplicação Financeira
  CASH_REGISTER // Caixa Físico (Gaveta / Dinheiro)
}

enum BankTransactionType {
  CREDIT // Entrada de fundos
  DEBIT // Saída de fundos
}

// ==========================================
// 1. TENANTS & AUTENTICAÇÃO
// ==========================================

model Tenant {
  id                    String    @id @default(uuid()) @db.Uuid
  name                  String    @db.VarChar(255) // Razão Social
  tradeName             String?   @db.VarChar(255) // Nome Fantasia
  document              String    @unique @db.VarChar(20) // CNPJ ou CPF (apenas números)
  stateRegistration     String?   @db.VarChar(30) // Inscrição Estadual (IE)
  municipalRegistration String?   @db.VarChar(30) // Inscrição Municipal (IM)
  taxRegime             TaxRegime @default(SIMPLES_NACIONAL)
  email                 String    @db.VarChar(150)
  phone                 String?   @db.VarChar(20)

  // Endereço fiscal
  street       String? @db.VarChar(255)
  number       String? @db.VarChar(30)
  complement   String? @db.VarChar(100)
  neighborhood String? @db.VarChar(100)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(2) // Sigla UF
  zipCode      String? @db.VarChar(10) // CEP
  ibgeCode     String? @db.VarChar(10) // Código IBGE Cidade

  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)

  // Relacionamentos operacionais multi-tenant
  users              User[]
  contacts           Contact[]
  products           Product[]
  productBatches     ProductBatch[]
  salesOrders        SalesOrder[]
  salesOrderItems    SalesOrderItem[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]
  chartOfAccounts    ChartOfAccount[]
  financialRecords   FinancialRecord[]
  bankAccounts       BankAccount[]
  bankTransactions   BankTransaction[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  name         String   @db.VarChar(150)
  email        String   @db.VarChar(150)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(OPERATOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ==========================================
// 2. CADASTRO UNIFICADO DE PESSOAS (CONTACTS)
// ==========================================

model Contact {
  id                    String      @id @default(uuid()) @db.Uuid
  tenantId              String      @db.Uuid
  personType            PersonType  @default(LEGAL_ENTITY)
  role                  ContactRole @default(CUSTOMER)
  name                  String      @db.VarChar(255) // Razão Social / Nome Completo
  tradeName             String?     @db.VarChar(255) // Nome Fantasia / Apelido
  document              String?     @db.VarChar(20) // CPF ou CNPJ
  stateRegistration     String?     @db.VarChar(30)
  municipalRegistration String?     @db.VarChar(30)
  email                 String?     @db.VarChar(150)
  phone                 String?     @db.VarChar(20)
  mobile                String?     @db.VarChar(20)

  // Endereço
  street       String? @db.VarChar(255)
  number       String? @db.VarChar(30)
  complement   String? @db.VarChar(100)
  neighborhood String? @db.VarChar(100)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(2)
  zipCode      String? @db.VarChar(10)

  creditLimit Decimal? @db.Decimal(15, 2)
  notes       String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrders      SalesOrder[]
  purchaseOrders   PurchaseOrder[]
  financialRecords FinancialRecord[]

  @@index([tenantId, role])
  @@index([tenantId, document])
  @@index([tenantId, name])
  @@map("contacts")
}

// ==========================================
// 3. CATÁLOGO DE PRODUTOS E SERVIÇOS
// ==========================================

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  type              ProductType   @default(PRODUCT)
  sku               String        @db.VarChar(60) // Código interno / SKU
  barcode           String?       @db.VarChar(60) // EAN/GTIN
  name              String        @db.VarChar(255)
  description       String?       @db.Text
  unitOfMeasure     UnitOfMeasure @default(UN) @map("unit_of_measure") // UN, KG, G, L, ML, M
  unit              String?       @default("UN") @db.VarChar(10) // Compatibilidade legada
  isBatchControlled Boolean       @default(false) @map("is_batch_controlled") // Rastreabilidade por Lote e Validade

  // Precificação e Estoque (Decimais de alta precisão 12,4 para custos e insumos fracionados)
  salePrice     Decimal @map("sale_price") @db.Decimal(12, 4)
  costPrice     Decimal @default(0) @map("cost_price") @db.Decimal(12, 4)
  stockQuantity Decimal @default(0) @map("stock_quantity") @db.Decimal(12, 4)
  minStock      Decimal @default(0) @map("min_stock") @db.Decimal(12, 4)

  // Informações Fiscais Básicas
  ncm         String? @db.VarChar(10) // NCM 8 dígitos
  nbs         String? @db.VarChar(10) // NBS p/ Serviços
  cest        String? @db.VarChar(10) // CEST
  cfopDefault String? @db.VarChar(10) // CFOP padrão (ex: 5102)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches            ProductBatch[]
  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, name])
  @@map("products")
}

// ==========================================
// 3.1 LOTES E VALIDADE (RASTREABILIDADE)
// ==========================================

model ProductBatch {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  batchCode      String    @map("batch_code") @db.VarChar(60)
  expirationDate DateTime? @map("expiration_date") @db.Date
  quantity       Decimal   @default(0) @map("quantity") @db.Decimal(12, 4)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([tenantId, productId, batchCode])
  @@index([tenantId, productId])
  @@index([tenantId, expirationDate])
  @@map("product_batches")
}

// ==========================================
// 3.2 TABELA DE DOMÍNIO - TIPOS DE MOVIMENTO (PADRÃO SAP)
// ==========================================

model MovementType {
  code           String            @id @db.VarChar(10) // 101, 201, 202, 301, 501, 502, 601, 602
  description    String            @db.VarChar(150)
  direction      MovementDirection // IN, OUT, TRANSFER
  requiresReason Boolean           @default(false) @map("requires_reason")
  requiresBatch  Boolean           @default(false) @map("requires_batch")
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  stockMovements StockMovement[]

  @@map("movement_types")
}

// ==========================================
// 4. VENDAS E FATURAMENTO
// ==========================================

model SalesOrder {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  orderNumber  Int // Número sequencial legível
  customerId   String           @db.Uuid
  status       SalesOrderStatus @default(DRAFT)
  issueDate    DateTime         @default(now()) @db.Timestamptz(6)
  deliveryDate DateTime?        @db.Timestamptz(6)
  paymentTerm  String?          @db.VarChar(100) // ex: "30/60/90", "À Vista"

  // Totais calculados
  totalGross    Decimal @default(0) @db.Decimal(15, 2)
  totalDiscount Decimal @default(0) @db.Decimal(15, 2)
  totalFreight  Decimal @default(0) @db.Decimal(15, 2)
  totalTaxes    Decimal @default(0) @db.Decimal(15, 2)
  totalNet      Decimal @default(0) @db.Decimal(15, 2)

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Contact           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            SalesOrderItem[]
  financialRecords FinancialRecord[]
  stockMovements   StockMovement[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, issueDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  salesOrderId String   @db.Uuid
  productId    String   @db.Uuid
  quantity     Decimal  @db.Decimal(12, 4)
  unitPrice    Decimal  @db.Decimal(12, 4)
  discount     Decimal  @default(0) @db.Decimal(15, 2)
  totalPrice   Decimal  @db.Decimal(15, 2)
  notes        String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, salesOrderId])
  @@index([tenantId, productId])
  @@map("sales_order_items")
}

// ==========================================
// 5. COMPRAS E ENTRADA DE NOTAS
// ==========================================

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  orderNumber Int
  supplierId  String              @db.Uuid
  status      PurchaseOrderStatus @default(DRAFT)

  // Vínculo com Nota Fiscal Eletrônica (NF-e)
  invoiceKey    String? @db.VarChar(44) // Chave NF-e 44 dígitos
  invoiceSeries String? @db.VarChar(10)
  invoiceNumber String? @db.VarChar(20)
  xmlUrl        String? @db.VarChar(500) // Link p/ arquivo XML armazenado

  issueDate   DateTime  @default(now()) @db.Timestamptz(6)
  arrivalDate DateTime? @db.Timestamptz(6)

  totalGross         Decimal @default(0) @db.Decimal(15, 2)
  totalDiscount      Decimal @default(0) @db.Decimal(15, 2)
  totalFreight       Decimal @default(0) @db.Decimal(15, 2)
  totalOtherExpenses Decimal @default(0) @db.Decimal(15, 2)
  totalNet           Decimal @default(0) @db.Decimal(15, 2)

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier         Contact             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items            PurchaseOrderItem[]
  financialRecords FinancialRecord[]
  stockMovements   StockMovement[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, invoiceKey])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  purchaseOrderId String   @db.Uuid
  productId       String   @db.Uuid
  quantity        Decimal  @db.Decimal(12, 4)
  unitCost        Decimal  @db.Decimal(12, 4)
  discount        Decimal  @default(0) @db.Decimal(15, 2)
  otherExpenses   Decimal  @default(0) @db.Decimal(15, 2)
  totalCost       Decimal  @db.Decimal(15, 2)
  notes           String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, productId])
  @@map("purchase_order_items")
}

// ==========================================
// 6. MOVIMENTAÇÕES DE ESTOQUE (AUDITÁVEL)
// ==========================================

model StockMovement {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  batchId          String? @map("batch_id") @db.Uuid
  movementTypeCode String  @map("movement_type_code") @db.VarChar(10)

  quantity      Decimal  @map("quantity") @db.Decimal(12, 4) // Quantidade movimentada (alta precisão)
  previousStock Decimal  @map("previous_stock") @db.Decimal(12, 4) // Saldo anterior do produto
  newStock      Decimal  @map("new_stock") @db.Decimal(12, 4) // Saldo resultante do produto
  unitCost      Decimal? @map("unit_cost") @db.Decimal(12, 4) // Custo unitário no momento
  totalCost     Decimal? @map("total_cost") @db.Decimal(15, 2)

  documentNumber String? @map("document_number") @db.VarChar(100) // Código único da operação (ordem, fatura, nota)
  userId         String? @map("user_id") @db.Uuid // Operador responsável
  reason         String? @db.Text // Justificativa obrigatória para perdas/avarias/estornos

  // Vínculos operacionais complementares
  referenceType   StockReferenceType? @map("reference_type")
  referenceId     String?             @map("reference_id") @db.VarChar(100)
  salesOrderId    String?             @map("sales_order_id") @db.Uuid
  purchaseOrderId String?             @map("purchase_order_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch         ProductBatch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  movementType  MovementType   @relation(fields: [movementTypeCode], references: [code], onDelete: Restrict)
  salesOrder    SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, movementTypeCode])
  @@index([tenantId, batchId])
  @@index([tenantId, documentNumber])
  @@index([tenantId, salesOrderId])
  @@index([tenantId, purchaseOrderId])
  @@map("stock_movements")
}

// ==========================================
// 7. GESTÃO FINANCEIRA & PLANO DE CONTAS
// ==========================================

model ChartOfAccount {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @db.Uuid
  code      String              @db.VarChar(30) // ex: "1.01.001", "2.02.010"
  name      String              @db.VarChar(150) // ex: "Receita de Serviços", "Aluguel"
  type      AccountCategoryType
  parentId  String?             @db.Uuid
  active    Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent           ChartOfAccount?   @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         ChartOfAccount[]  @relation("AccountHierarchy")
  financialRecords FinancialRecord[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("chart_of_accounts")
}

model FinancialRecord {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @db.Uuid
  type        FinancialRecordType // RECEIVABLE (Receber) ou PAYABLE (Pagar)
  status      FinancialRecordStatus @default(PENDING)
  description String                @db.VarChar(255)

  contactId        String? @db.Uuid // Cliente ou Fornecedor
  chartOfAccountId String? @db.Uuid // Categoria / Plano de contas

  dueDate        DateTime  @db.Date // Data de Vencimento
  issueDate      DateTime  @default(now()) @db.Date // Data de Emissão
  competencyDate DateTime  @default(now()) @db.Date // Data de Competência (DRE)
  paymentDate    DateTime? @db.Date // Data de Liquidação

  // Valores da parcela / título
  originalAmount Decimal @db.Decimal(15, 2)
  discountAmount Decimal @default(0) @db.Decimal(15, 2)
  fineAmount     Decimal @default(0) @db.Decimal(15, 2) // Multa
  interestAmount Decimal @default(0) @db.Decimal(15, 2) // Juros
  paidAmount     Decimal @default(0) @db.Decimal(15, 2) // Valor já pago
  balanceAmount  Decimal @db.Decimal(15, 2) // Saldo em aberto

  // Controle de Parcelamento
  installmentNumber Int @default(1)
  totalInstallments Int @default(1)

  // Vínculos de origem
  salesOrderId    String?  @db.Uuid
  purchaseOrderId String?  @db.Uuid
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact          Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  chartOfAccount   ChartOfAccount?   @relation(fields: [chartOfAccountId], references: [id], onDelete: SetNull)
  salesOrder       SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  purchaseOrder    PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  bankTransactions BankTransaction[]

  @@index([tenantId, type, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, contactId])
  @@index([tenantId, salesOrderId])
  @@index([tenantId, purchaseOrderId])
  @@map("financial_records")
}

// ==========================================
// 8. CONTAS BANCÁRIAS E CONCILIAÇÃO
// ==========================================

model BankAccount {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  name           String          @db.VarChar(100) // ex: "Itaú Conta PJ", "Caixa Loja 1"
  bankCode       String?         @db.VarChar(10) // Código FEBRABAN (ex: "341")
  bankName       String?         @db.VarChar(100)
  agency         String?         @db.VarChar(20)
  accountNumber  String?         @db.VarChar(30)
  accountType    BankAccountType @default(CHECKING)
  initialBalance Decimal         @default(0) @db.Decimal(15, 2)
  currentBalance Decimal         @default(0) @db.Decimal(15, 2)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([tenantId, active])
  @@map("bank_accounts")
}

model BankTransaction {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @db.Uuid
  bankAccountId       String              @db.Uuid
  financialRecordId   String?             @db.Uuid // Título conciliado
  type                BankTransactionType // CREDIT ou DEBIT
  amount              Decimal             @db.Decimal(15, 2)
  transactionDate     DateTime            @db.Date
  description         String              @db.VarChar(255)
  reconciled          Boolean             @default(false)
  reconciledAt        DateTime?           @db.Timestamptz(6)
  externalReferenceId String?             @db.VarChar(100) // ID Pix (EndToEnd), doc bancário, ID OFX
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  financialRecord FinancialRecord? @relation(fields: [financialRecordId], references: [id], onDelete: SetNull)

  @@index([tenantId, bankAccountId, transactionDate])
  @@index([tenantId, reconciled])
  @@index([tenantId, financialRecordId])
  @@map("bank_transactions")
}
